/.claudinite-hooks.log
/.claudinite-hooks.log.tmp
# Failure artifacts from a red requirement case never sit beside the goldens.
# The Flutter harness writes its actual/expected/diff renders into a failures/
# directory next to whichever test ran.
failures/
.DS_Store

# Dart/Flutter build state. The SDK version itself is pinned in
# .flutter-version, because a golden rendered by one Flutter version is not
# portable to another (risk R6).
.dart_tool/
build/
